{
  "name": "Shapers OS",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Shapers OS", "onAutoForward": "openPreview", "visibility": "private" }
  },
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": { "vscode": { "settings": { "editor.formatOnSave": true } } }
}
