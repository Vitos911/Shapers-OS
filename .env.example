SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server only: Auth provisioning and trusted Google event synchronization.
SUPABASE_SECRET_KEY=
# Server only. Exact origin (https://your-domain.example in production).
APP_URL=http://localhost:3000
# Random 32+ characters, shared by all instances; never NEXT_PUBLIC_.
AUTH_COOKIE_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_TIMEZONE=Europe/Ljubljana
# Private calendar: service account shared as Reader, OR readonly OAuth refresh token.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Same OAuth client as Supabase Google provider; server only, used to renew PERSONAL calendar grants too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Explicit opt-in for fictional sandbox authentication only.
DEMO_AUTH_ENABLED=false
