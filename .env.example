# Public configuration: returned to the browser ONLY by /api/supabase-config.
# Keep the existing names; NEXT_PUBLIC_* duplicates are not used by this app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server only: Auth provisioning, trusted Google sync and private leaderboard aggregation.
# Server secret: Auth provisioning, approved invitations and trusted Calendar sync.
SUPABASE_SECRET_KEY=
# Server config. Exact origin, no path/query. Production: actual HTTPS app domain.
# Preview: set a separate exact APP_URL for each canonical feature-branch alias.
# Do not reuse the Production APP_URL for Preview; origin checks will reject it.
APP_URL=http://localhost:3000
# Random 32+ characters, shared by all instances; never NEXT_PUBLIC_.
AUTH_COOKIE_SECRET=
# Shared organization calendar: ID may alternatively be set in org_settings.
GOOGLE_CALENDAR_ID=
# Server secret; use only for a public calendar, restrict to Calendar API.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_TIMEZONE=Europe/Ljubljana
# Server secret: private shared calendar, Reader service account OR readonly OAuth.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Same OAuth client as Supabase Google provider; server only, used to renew PERSONAL calendar grants too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Explicit opt-in for fictional sandbox authentication only.
DEMO_AUTH_ENABLED=false

# Ask Shaper (server only). Provider: groq or openai; empty infers Groq from GROQ_API_KEY / gsk_ prefix.
# Defaults: Groq openai/gpt-oss-20b; OpenAI gpt-4.1-mini.
SHAPER_AI_PROVIDER=
SHAPER_AI_API_KEY=
SHAPER_AI_MODEL=
# Optional Groq-specific alias when SHAPER_AI_API_KEY is empty.
GROQ_API_KEY=
# Optional Slack Web API integration. Server only; never NEXT_PUBLIC_ or Git.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Explicit opt-in for the Superadmin-only fixed test message. Keep false normally.
SLACK_TEST_ENABLED=false

